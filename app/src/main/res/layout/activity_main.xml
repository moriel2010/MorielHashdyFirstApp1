<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F9FF">



            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:gravity="center"
                android:text="@string/user_name"
                android:textColor="#3675F4"
                android:textSize="35sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ImageView
                android:id="@+id/btn_img1"
                android:layout_width="250dp"
                android:layout_height="200dp"
                android:layout_marginTop="25dp"
                android:contentDescription="תמונה ראשונה"
                android:scaleType="centerCrop"
                android:src="@drawable/img1"
                app:layout_constraintTop_toBottomOf="@id/tvUserName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ImageView
                android:id="@+id/btn_img2"
                android:layout_width="250dp"
                android:layout_height="200dp"
                android:contentDescription="תמונה שנייה"
                android:scaleType="centerCrop"
                android:src="@drawable/img2"
                app:layout_constraintTop_toTopOf="@id/btn_img1"
                app:layout_constraintBottom_toBottomOf="@id/btn_img1"
                app:layout_constraintStart_toStartOf="@id/btn_img1"
                app:layout_constraintEnd_toEndOf="@id/btn_img1" />

            <TextView
                android:id="@+id/tvGameTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="🎯 נחש את המספר!"
                android:textColor="#3675F4"
                android:textSize="27sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/btn_img1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvInstructions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="בחר את טווח המספרים להגרלה:"
                android:textSize="18sp"
                app:layout_constraintTop_toBottomOf="@id/tvGameTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <EditText
                android:id="@+id/etMin"
                android:layout_width="130dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:hint="מינימום"
                android:inputType="number"
                android:minHeight="48dp"
                app:layout_constraintTop_toBottomOf="@id/tvInstructions"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/etMax" />

            <EditText
                android:id="@+id/etMax"
                android:layout_width="130dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:hint="מקסימום"
                android:inputType="number"
                android:minHeight="48dp"
                app:layout_constraintTop_toBottomOf="@id/tvInstructions"
                app:layout_constraintStart_toEndOf="@id/etMin"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btnStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="התחל משחק"
                app:layout_constraintTop_toBottomOf="@id/etMin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <EditText
                android:id="@+id/etGuess"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:gravity="center"
                android:hint="הכנס ניחוש..."
                android:inputType="number"
                android:minHeight="48dp"
                android:textSize="20sp"
                app:layout_constraintTop_toBottomOf="@id/btnStart"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btnCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="בדוק ניחוש!"
                app:layout_constraintTop_toBottomOf="@id/etGuess"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:gravity="center"
                android:text="בחר טווח והתחל לשחק!"
                android:textColor="#3675F4"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/btnCheck"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="מספר ניסיונות: 0"
                android:textSize="18sp"
                app:layout_constraintTop_toBottomOf="@id/tvResult"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvHistory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:gravity="center"
                android:text="הניחושים הקודמים:"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/tvCount"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btnPlayAgain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="שחק שוב"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tvHistory"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btnSendMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="104dp"
                android:text="@string/send_message"
                app:layout_constraintEnd_toStartOf="@id/btnFollow"
                app:layout_constraintTop_toBottomOf="@id/btnPlayAgain" />

            <Button
                android:id="@+id/btnFollow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="188dp"
                android:layout_marginTop="24dp"
                android:text="@string/follow"
                app:layout_constraintStart_toEndOf="@id/btnSendMessage"
                app:layout_constraintTop_toBottomOf="@id/btnPlayAgain" />

            <Switch
                android:id="@+id/switch1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Switch"
                app:layout_constraintTop_toBottomOf="@id/btnFollow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <SeekBar
                android:id="@+id/mySeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:max="100"
                app:layout_constraintTop_toBottomOf="@id/switch1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>



